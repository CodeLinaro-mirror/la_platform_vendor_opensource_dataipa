ifeq ($(KP_MODULE_ROOT),)
KP_MODULE_ROOT=$(KERNEL_SRC)/$(M)
endif

KBUILD_OPTIONS+=KBUILD_DTC_INCLUDE=$(KP_MODULE_ROOT)
KBUILD_OPTIONS += CONFIG_GSI=m
KBUILD_OPTIONS += CONFIG_IPA3=m
KBUILD_OPTIONS += CONFIG_IPA_CLIENTS_MANAGER=m
KBUILD_OPTIONS += CONFIG_RNDIS_IPA=m
KBUILD_OPTIONS += CONFIG_ECM_IPA=m
KBUILD_OPTIONS += CONFIG_IPA_UT=m
KBUILD_OPTIONS += CONFIG_IPA_KERNEL_TESTS_MODULE=m




all: modules # dtbs

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) clean

%:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) $@ $(KBUILD_OPTIONS)
